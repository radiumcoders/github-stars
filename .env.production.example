# Production GitHub App. Use a separate App, database, and Better Auth secret.
# Blank values fail `pnpm run check:env`. Never commit secrets.
BETTER_AUTH_URL=https://YOUR-PRODUCTION-HOST
NEXT_PUBLIC_BASE_URL=https://YOUR-PRODUCTION-HOST
BETTER_AUTH_SECRET=
DATABASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
