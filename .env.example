# Copy to .env.local for local development, or use the environment-specific
# example files. Never commit real secrets.
#
# Register a GitHub App (not an OAuth App):
#   Repository permissions: Metadata = Read-only
#   Account permissions: Email addresses = Read-only
#   Everything else: No access
#   Expire user authorization tokens: enabled
#   Request user authorization during installation: disabled
#   Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
#   Setup URL: {BETTER_AUTH_URL}/github/setup
#   Webhooks: disabled
# Client ID is NOT the numeric App ID. No private key is required.

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
